{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vibebackbone runtime conformance result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "scenario_id",
    "route",
    "signals",
    "mutations",
    "final_status_present",
    "metrics"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "provider": {"enum": ["pi", "opencode", "codex", "claude"]},
    "scenario_id": {"type": "string", "minLength": 1},
    "route": {
      "enum": [
        "FAST-ZERO",
        "FAST-MINIMAL",
        "FAST-STANDARD",
        "STRUCTURED",
        "AUDIT",
        "MVP START",
        "ENGINE_ONLY",
        "CLOSE-HANDOFF",
        "CLOSE-FINAL"
      ]
    },
    "signals": {
      "type": "array",
      "items": {
        "enum": [
          "read_only",
          "scope_bounded",
          "activity_log_only",
          "patch_summary_required",
          "direct_action_allowed",
          "plan_required",
          "gate_required",
          "audit_report_required",
          "implementation_blocked",
          "blocking_questions_required",
          "risk_escalated",
          "surface_cartography_required",
          "session_handoff_required",
          "session_clear_required"
        ]
      },
      "uniqueItems": true
    },
    "mutations": {"type": "array", "items": {"type": "string"}},
    "final_status_present": {"type": "boolean"},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latency_ms", "input_tokens", "output_tokens", "cost_usd"],
      "properties": {
        "latency_ms": {"type": ["integer", "null"], "minimum": 0},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cost_usd": {"type": ["number", "null"], "minimum": 0}
      }
    }
  }
}
