#!/usr/bin/env bash
# pre-commit-framework-gate
# Hook pre-commit (1/2 de la framework commit gate).
# Responsabilité : détecter les commits hors-scope.
#
# Comportement :
#  1. Lit les fichiers modifiés (git diff --cached --name-only).
#  2. Si aucun fichier n'est dans le repo vibebackbone (docs/, skills/,
#     prompts/, tools/, scripts/, distributions/), exit 0
#     silencieusement.
#  3. Sinon, exit 0 (la validation du message est faite par
#     commit-msg-framework-gate — ce hook ne s'en mêle pas).
#
# Extension Phase 2 Run 1 (P0-1 §4.4, 2026-06-13) :
#  - Si un fichier `*/07_CLOSEOUT.md` est staged, le hook appelle
#    `tools/vbb-loop-closure-check.py` avec `--validate-claims` sur le
#    run_id correspondant. Si erreur → bloque le commit (exit 1).
#  - Si un fichier `*/04_PLAN.md` est staged, le hook appelle le tool
#    avec `--validate-plan` (P0-2 §4.1). Si erreur → bloque.
#  - Si un fichier `*/05_EXECUTION.md` est staged dans un run
#    STRUCTUREE/AUDIT/CLOSEOUT, le hook appelle le tool avec
#    `--validate-test-audit` (P0-3 §4.1).
#  - Tous ces checks sont **additifs et tolérants** : un échec affiche
#    un message clair mais n'altère pas le flow des commits hors-scope.
#  - ADR 0033 (2026-07-14) : appelle la credentials gate Core sur les lignes
#    staged ajoutées. Un finding bloque le commit sans imprimer la valeur.
#
# Bash pur, pas de dépendance externe.
#
# Note 2026-06-13 (ADR 0013 Phase 3 prep, R1) : `distributions/*` ajouté
# à la whitelist car les artefacts des providers supportés sont désormais des
# citoyens de premier plan du repo. ADR 0013 Accepted, partiellement remplacé
# par ADR 0025.

set -u

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
PYTHON="${PYTHON:-python3}"
command -v python >/dev/null 2>&1 && PYTHON="${PYTHON_OVERRIDE:-python}"

STAGED="$(git diff --cached --name-only 2>/dev/null || true)"

in_repo=0
closeout_staged=""
plan_staged=""
execution_staged=""
if [ -n "$STAGED" ]; then
    while IFS= read -r f; do
        case "$f" in
            docs/*|skills/*|prompts/*|tools/*|scripts/*|distributions/*)
                in_repo=1
                case "$f" in
                    */07_CLOSEOUT.md) closeout_staged="$f" ;;
                    */04_PLAN.md)     plan_staged="$f" ;;
                    */05_EXECUTION.md) execution_staged="$f" ;;
                esac
                ;;
        esac
    done <<< "$STAGED"
fi

# ── P0-1 §4.4 — claims evidence on staged 07_CLOSEOUT.md ──────────────
if [ -n "$closeout_staged" ] && [ -f "$REPO_ROOT/tools/vbb-loop-closure-check.py" ]; then
    # Extract run_id from the staged closeout path:
    # docs/runs/<run_id>/07_CLOSEOUT.md → <run_id>
    run_id="$(printf '%s' "$closeout_staged" | awk -F/ '{print $3}')"
    if [ -n "$run_id" ] && [ -d "$REPO_ROOT/docs/runs/$run_id" ]; then
        echo "[pre-commit] P0-1: validating claims in $closeout_staged (run_id=$run_id) …"
        if ! "$PYTHON" "$REPO_ROOT/tools/vbb-loop-closure-check.py" "$run_id" \
                --strict --validate-claims --runs-dir "$REPO_ROOT/docs/runs" \
                >/dev/null 2>&1; then
            echo "[pre-commit] P0-1 FAIL: 07_CLOSEOUT.md has claims without evidence." >&2
            echo "[pre-commit] Run:" >&2
            echo "    $PYTHON $REPO_ROOT/tools/vbb-loop-closure-check.py $run_id --strict --validate-claims" >&2
            echo "[pre-commit] Fix the closeout, re-stage, then re-commit." >&2
            exit 1
        fi
    fi
fi

# ── P0-2 §4.1 — plan sections on staged 04_PLAN.md ───────────────────
if [ -n "$plan_staged" ] && [ -f "$REPO_ROOT/tools/vbb-loop-closure-check.py" ]; then
    run_id="$(printf '%s' "$plan_staged" | awk -F/ '{print $3}')"
    if [ -n "$run_id" ] && [ -d "$REPO_ROOT/docs/runs/$run_id" ]; then
        echo "[pre-commit] P0-2: validating plan sections in $plan_staged (run_id=$run_id) …"
        if ! "$PYTHON" "$REPO_ROOT/tools/vbb-loop-closure-check.py" "$run_id" \
                --strict --validate-plan --runs-dir "$REPO_ROOT/docs/runs" \
                >/dev/null 2>&1; then
            echo "[pre-commit] P0-2 FAIL: 04_PLAN.md has missing/empty/placeholder sections." >&2
            echo "[pre-commit] Run:" >&2
            echo "    $PYTHON $REPO_ROOT/tools/vbb-loop-closure-check.py $run_id --strict --validate-plan" >&2
            exit 1
        fi
    fi
fi

# ── P0-3 §4.1 — test audit on staged 05_EXECUTION.md ─────────────────
if [ -n "$execution_staged" ] && [ -f "$REPO_ROOT/tools/vbb-loop-closure-check.py" ]; then
    run_id="$(printf '%s' "$execution_staged" | awk -F/ '{print $3}')"
    if [ -n "$run_id" ] && [ -d "$REPO_ROOT/docs/runs/$run_id" ]; then
        # Skip if voie is not STRUCTUREE/AUDIT/CLOSEOUT
        intake="$REPO_ROOT/docs/runs/$run_id/01_INTAKE.md"
        if [ -f "$intake" ]; then
            voie="$(awk '/^voie:/{ $1=""; sub(/^ /,""); print; exit }' "$intake" | tr -d '"' | tr -d "'" | tr -d '\r')"
            case "$voie" in
                STRUCTUREE|AUDIT|CLOSEOUT)
                    echo "[pre-commit] P0-3: validating test audit for $execution_staged (run_id=$run_id, voie=$voie) …"
                    if ! "$PYTHON" "$REPO_ROOT/tools/vbb-loop-closure-check.py" "$run_id" \
                            --strict --validate-test-audit --runs-dir "$REPO_ROOT/docs/runs" \
                            >/dev/null 2>&1; then
                        echo "[pre-commit] P0-3 FAIL: STRUCTUREE/AUDIT/CLOSEOUT run is missing a recent test audit report." >&2
                        echo "[pre-commit] Fix: invoke t-vbb-test-coverage-mapper or 1-vbb-test-mirage-detector," >&2
                        echo "[pre-commit]      or add 'no test surface' to 05_EXECUTION.md." >&2
                        exit 1
                    fi
                    ;;
            esac
        fi
    fi
fi

# ── P0-5 §4.2 — credentials enforcement (Core rule §13, ADR 0033) ───
if [ -n "$STAGED" ]; then
    credentials_gate="$REPO_ROOT/tools/vbb-credentials-gate.py"
    if [ ! -f "$credentials_gate" ]; then
        echo "[pre-commit] P0-5 FAIL: credentials gate tool missing: $credentials_gate" >&2
        exit 1
    fi
    echo "[pre-commit] P0-5: checking added staged content for credentials …"
    if ! "$PYTHON" "$credentials_gate" --staged; then
        echo "[pre-commit] P0-5 FAIL: credentials gate failed; remove the value or use a justified example marker." >&2
        exit 1
    fi
fi

# Hors-scope : exit 0 silencieux.
# In-scope : exit 0 — le commit-msg-hook fera la validation du message.
exit 0
